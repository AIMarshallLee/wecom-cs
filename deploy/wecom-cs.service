# ============================================================
# wecom-cs systemd 服务单元
# 安装：
#   sudo cp deploy/wecom-cs.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now wecom-cs
# 查看：sudo systemctl status wecom-cs
# 日志：sudo journalctl -u wecom-cs -f
# ============================================================

[Unit]
Description=WeCom Customer Service (wecom-cs) - gunicorn server
Documentation=file:///opt/wecom-cs/README.md
After=network-online.target redis.service
Wants=network-online.target

[Service]
Type=simple

# 运行用户
User=www-data
Group=www-data

# 工作目录
WorkingDirectory=/opt/wecom-cs

# 环境变量：设置 PYTHONPATH 以便导入 app 包
Environment=PYTHONPATH=/opt/wecom-cs
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# 如需指定日志级别，可取消注释
# Environment=LOG_LEVEL=INFO

# 启动命令：gunicorn + uvicorn worker（配置文件 deploy/gunicorn_config.py）
# 使用项目虚拟环境中的 gunicorn
ExecStart=/opt/wecom-cs/venv/bin/gunicorn -c deploy/gunicorn_config.py app.main:app
ExecReload=/bin/kill -HUP $MAINPID

# 自动重启策略
Restart=always
RestartSec=10
StartLimitInterval=60
StartLimitBurst=5

# 资源与安全加固
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true

# 日志输出到 journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wecom-cs

[Install]
WantedBy=multi-user.target
